# Copy to .env and fill in. Everything is optional: without keys the app
# uses its built-in guide, phrase cards, and the phone's own SMS app.

PORT=3000

# AI: live translation, translated rights card, tailored steps.
# Set ONE of these. If you set both, AI_PROVIDER=gemini or anthropic picks.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   # or gemini-3.8-flash for higher quality
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_PROVIDER=gemini

# Google / Apple sign-in through Auth0 (see README). Email accounts work without this.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# AUTH0_APPLE=true   # only after Apple is configured in Auth0

# Email alerts (Gmail: use an App password, not your normal password)
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# iCloud link to the shared "Crashline SOS" Shortcut (Shortcuts → share → Copy iCloud Link).
# The app shows an "Add Shortcut" button so anyone can set up auto-texts in a minute.
SHORTCUT_URL=

# Automatic texting (twilio.com). Trial accounts can only text verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15555550123
